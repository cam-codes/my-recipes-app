{
  "imports": {
    "@std/assert": "jsr:@std/assert",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "std/": "https://deno.land/std@0.203.0/",
    "vitest": "npm:vitest@^4.0.18"
  },
  "tasks": {
    "cache": "deno cache server.ts",
    "cache:reload": "deno cache --reload server.ts",
    "fmt:check": "deno fmt --check",
    "fmt:fix": "deno fmt",
    "lint:check": "deno lint",
    "lint:fix": "deno lint --fix",
    "start": "deno run --cached-only --allow-net --allow-read --allow-write --allow-env server.ts",
    "test": "deno test --allow-read --allow-net --allow-import --allow-env --allow-write",
    "test:coverage": "deno test --allow-read --allow-net --allow-import --allow-env --allow-write --coverage=coverage && deno coverage coverage --lcov > coverage.lcov"
  }
}
