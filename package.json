{
  "name": "my-recipes-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "docker-compose -f /Users/cam/stash/my-recipes-app/docker-compose.yml -f /Users/cam/stash/my-recipes-app/docker-compose.local.yml build --no-cache && docker-compose  -f /Users/cam/stash/my-recipes-app/docker-compose.yml  -f /Users/cam/stash/my-recipes-app/docker-compose.local.yml up",
    "clean": "docker-compose  -f /Users/cam/stash/my-recipes-app/docker-compose.yml  -f /Users/cam/stash/my-recipes-app/docker-compose.local.yml down && rm -rf node_modules yarn.lock frontend/node_modules frontend/dist .yarn/install-state.gz && yarn install && cd frontend && yarn build && cd ..",
    "clean:build": "yarn clean && yarn build",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "typescript-eslint": "^8.54.0"
  }
}
